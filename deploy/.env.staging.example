# Staging uses a separate DB, secret set and fake data. Never copy production data.
LIFEOS_IMAGE=<registry>/lifeos-backend:<release-candidate-tag-or-digest>
LIFEOS_MIGRATION_IMAGE=<registry>/lifeos-migrations:<same-release-candidate-tag-or-digest>
BACKEND_PORT=8081
BACKEND_CPUS=1.0
BACKEND_MEMORY=2g
DB_URL=jdbc:postgresql://<staging-private-host>:5432/<staging-database>?sslmode=require
DB_USER=<staging-runtime-dml-user>
DB_PASSWORD=<staging-secret>
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=1
MIGRATION_DB_URL=jdbc:postgresql://<staging-private-host>:5432/<staging-database>?sslmode=require
MIGRATION_DB_USER=<staging-migration-ddl-user>
MIGRATION_DB_PASSWORD=<staging-secret>
JWT_SECRET=<staging-base64-secret-at-least-32-random-bytes>
JWT_KID=staging-k1
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=
NOTIFICATION_UNSUBSCRIBE_SECRET=<different-staging-secret-at-least-32-characters>
SNAPSHOT_HMAC_SECRET=<another-different-staging-secret-at-least-32-characters>
APP_BASE_URL=https://staging.<owned-domain>
API_BASE_URL=https://staging-api.<owned-domain>
TRUSTED_PROXIES=<exact-platform-or-reverse-proxy-ip-regex>
SMTP_HOST=<staging-smtp-host>
SMTP_PORT=587
SMTP_USER=<staging-smtp-user>
SMTP_PASSWORD=<staging-secret>
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=LifeOS Staging <no-reply@<owned-domain>>
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
