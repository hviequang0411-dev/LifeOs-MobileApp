# Copy to a file outside version control and replace every <...> value.
LIFEOS_IMAGE=<registry>/lifeos-backend:<immutable-tag-or-digest>
LIFEOS_MIGRATION_IMAGE=<registry>/lifeos-migrations:<same-release-tag-or-digest>
BACKEND_PORT=8080
BACKEND_CPUS=1.0
BACKEND_MEMORY=2g
DB_URL=jdbc:postgresql://<private-host>:5432/<database>?sslmode=require
DB_USER=<runtime-dml-user>
DB_PASSWORD=<secret>
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
MIGRATION_DB_URL=jdbc:postgresql://<private-host>:5432/<database>?sslmode=require
MIGRATION_DB_USER=<migration-ddl-user>
MIGRATION_DB_PASSWORD=<secret>
JWT_SECRET=<base64-at-least-32-random-bytes>
JWT_KID=prod-k1
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=
NOTIFICATION_UNSUBSCRIBE_SECRET=<different-random-secret-at-least-32-characters>
SNAPSHOT_HMAC_SECRET=<another-different-random-secret-at-least-32-characters>
APP_BASE_URL=https://app.<owned-domain>
API_BASE_URL=https://api.<owned-domain>
TRUSTED_PROXIES=<exact-platform-or-reverse-proxy-ip-regex>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<secret>
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=LifeOS <no-reply@<owned-domain>>
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
